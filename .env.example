PORT=5008
SITE_BASE_URL=https://www.cameronco.com.au

NIVODA_API_URL=https://intg-customer-staging.nivodaapi.net/api/diamonds
NIVODA_USERNAME=testaccount@sample.com
NIVODA_PASSWORD=staging-nivoda-22
PRICE_MARKUP_FACTOR=1.35

APPOINTMENT_MINUTES=45

# Shopify custom app (Dev Dashboard, client credentials grant). Used to
# create/update a Shopify Customer for whoever books an appointment.
SHOPIFY_SHOP=1bgeet-da.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_MELBOURNE_ID=
GOOGLE_CALENDAR_SYDNEY_ID=

# Booking storage. Leave blank to fall back to the local bookings-store.json
# file (fine for local dev, but data won't survive a restart on hosts with
# no persistent disk, e.g. Render's free tier).
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MELBOURNE_USER_ID=
ZOOM_SYDNEY_USER_ID=

# Fallback email config, only used if nothing has been set yet via
# /admin/email-settings (which stores its values in Firestore instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cameron & Co

# Shared key required by the /admin/email-settings page to view/update the
# bookings@cameronco.com.au SMTP password. Generate a long random value,
# e.g. `openssl rand -hex 32`, and keep it out of anything client-visible.
ADMIN_API_KEY=

COMPLETE_SMS_API_URL=
COMPLETE_SMS_API_TOKEN=
COMPLETE_SMS_SENDER=CameronCo
